# Application settings. Copy to .env for Docker Compose.
ORPHEUS_BASE_URL=http://orpheus:8080
ORPHEUS_API_KEY=
WORKFLOWS_DIR=workflows
# Optional: enables immediate attachment delivery to a running agent.
# AGENTBOX_API_KEY=
# Optional: overrides the SDK endpoint when AGENTBOX_API_KEY is set.
# AGENTBOX_API_URL=https://api.agentbox.example.com

# Secret referenced by mattermost.token_env in workflow front matter.
MATTERMOST_BOT_TOKEN=

# Optional process settings; shown values are the defaults.
# LISTEN_ADDR=:8080
# HTTP_TIMEOUT=30s
# MAX_REQUEST_BYTES=1048576
# MAX_PARALLEL_THREADS=8
